# --- Steam Web API (optional, FREE — get one at https://steamcommunity.com/dev/apikey) ---
# Player/profile tools (get_owned_games, get_player_summary, resolve_vanity_url,
# get_player_achievements, get_achievement_summary, get_recently_played) need this key.
# The whole store front + reviews + news + itch suite works WITHOUT it.
# Never commit a real key — this file is the template only.
STEAM_API_KEY=

# Optional default player for the player tools (so a SteamID64 need not be passed
# on every call). Accepts a 17-digit SteamID64 or a vanity name (resolved via the
# keyed Web API — requires STEAM_API_KEY).
STEAM_ID=

# --- Storefront region/locale (prices are region-aware) ---
STEAM_COUNTRY=US
STEAM_LANGUAGE=english

# --- Tuning (all optional) ---
# HTTP_TIMEOUT_MS=15000
# HTTP_RETRIES=2
# RATE_LIMIT_PER_MINUTE=60
# CACHE_MAX_SIZE=2000
# LOG_LEVEL=info
